{
  "name": "folio",
  "version": "0.1.0",
  "private": true,
  "description": "Folio \u2014 open-source everyday PDF editor",
  "license": "GPL-3.0-or-later",
  "type": "module",
  "packageManager": "pnpm@10.34.6",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "dev": "pnpm --filter @folio/web dev",
    "build": "pnpm --filter @folio/web build",
    "tauri": "pnpm --filter @folio/desktop tauri",
    "test": "vitest run --project unit",
    "test:conformance": "vitest run --project conformance",
    "test:interop": "vitest run --project interop",
    "test:e2e": "pnpm --filter @folio/web test:e2e",
    "test:all": "vitest run",
    "coverage": "vitest run --project unit --project conformance --coverage",
    "trace": "tsx tools/trace.ts",
    "fixtures:build": "tsx apps/cli/src/main.ts fixtures",
    "bench": "vitest run --project perf",
    "cli": "tsx apps/cli/src/main.ts",
    "lint": "eslint . && depcruise packages apps/cli apps/web/src --config .dependency-cruiser.cjs && tsx tools/sync-migrations.ts --check && tsx tools/i18n-lint.ts",
    "format": "prettier --write .",
    "check": "tsc -p tsconfig.json && pnpm --filter @folio/web check",
    "licenses": "tsx tools/licenses.ts",
    "appimage": "pnpm --filter @folio/desktop appimage",
    "appimage:smoke": "bash apps/desktop/scripts/smoke.sh",
    "test:golden:update": "FOLIO_UPDATE_GOLDENS=1 vitest run tests/golden",
    "gate": "bash tools/gate.sh",
    "fixtures:fetch": "tsx tools/fixtures-fetch.ts"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@folio/ai": "workspace:*",
    "@folio/app": "workspace:*",
    "@folio/core": "workspace:*",
    "@folio/db": "workspace:*",
    "@folio/engine-pdfium": "workspace:*",
    "@folio/ports": "workspace:*",
    "@folio/services": "workspace:*",
    "@folio/testkit": "workspace:*",
    "@types/node": "^22.20.5",
    "@types/pngjs": "^6.0.5",
    "@vitest/coverage-v8": "^5.0.3",
    "dependency-cruiser": "^18.6.0",
    "eslint": "^10.12.0",
    "fast-check": "^3.23.2",
    "prettier": "^3.9.10",
    "prettier-plugin-svelte": "^4.1.1",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.1",
    "vitest": "^5.0.3"
  }
}
