{
  "name": "folio",
  "version": "0.1.0",
  "private": true,
  "description": "Folio — open-source everyday PDF editor",
  "license": "GPL-3.0-or-later",
  "type": "module",
  "packageManager": "pnpm@10.34.6",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "dev": "pnpm --filter @folio/web dev",
    "build": "pnpm --filter @folio/web build",
    "tauri": "pnpm --filter @folio/desktop tauri",
    "test": "vitest run --project unit",
    "test:conformance": "vitest run --project conformance",
    "test:interop": "vitest run --project interop",
    "test:e2e": "pnpm --filter @folio/web test:e2e",
    "test:all": "vitest run",
    "coverage": "vitest run --project unit --project conformance --coverage",
    "trace": "tsx tools/trace.ts",
    "fixtures:build": "tsx tools/fixtures-build.ts",
    "fixtures:fetch": "tsx tools/fixtures-fetch.ts",
    "bench": "tsx tools/bench.ts",
    "cli": "tsx apps/cli/src/main.ts",
    "lint": "eslint . && depcruise packages apps --config .dependency-cruiser.cjs && prettier --check .",
    "format": "prettier --write .",
    "check": "tsc -b --noEmit false --emitDeclarationOnly --outDir node_modules/.tsbuild && pnpm --filter @folio/web check",
    "licenses": "tsx tools/licenses.ts",
    "appimage": "pnpm --filter @folio/desktop appimage",
    "appimage:smoke": "bash apps/desktop/scripts/smoke.sh"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@folio/ai": "workspace:*",
    "@folio/app": "workspace:*",
    "@folio/core": "workspace:*",
    "@folio/db": "workspace:*",
    "@folio/engine-pdfium": "workspace:*",
    "@folio/ports": "workspace:*",
    "@folio/services": "workspace:*",
    "@folio/testkit": "workspace:*",
    "@types/node": "^22.20.5",
    "@types/pngjs": "^6.0.5",
    "@vitest/coverage-v8": "^5.0.3",
    "dependency-cruiser": "^18.6.0",
    "eslint": "^10.12.0",
    "prettier": "^3.9.10",
    "prettier-plugin-svelte": "^4.1.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "typescript-eslint": "^8.71.1",
    "vitest": "^5.0.3"
  }
}
